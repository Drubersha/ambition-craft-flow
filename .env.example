# === App (Vite — build-time, inlined into client bundle) ===
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-generated-ANON_KEY
VITE_SUPABASE_PROJECT_ID=self-hosted

# === App (server runtime) ===
SUPABASE_URL=http://kong:8000
SUPABASE_PUBLISHABLE_KEY=replace-with-generated-ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=replace-with-generated-SERVICE_ROLE_KEY

# === Postgres ===
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=postgres

# === Supabase Auth (GoTrue) ===
# openssl rand -base64 48
JWT_SECRET=replace-with-strong-32+chars-secret
# Public site URL used in auth redirects and emails
SITE_URL=http://localhost:3000
# Disable email confirmation for dev; set true in production
GOTRUE_MAILER_AUTOCONFIRM=true

# === Generated JWTs (use https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys or scripts/gen-keys.mjs) ===
ANON_KEY=replace-with-generated-ANON_KEY
SERVICE_ROLE_KEY=replace-with-generated-SERVICE_ROLE_KEY

# === Studio (optional admin UI) ===
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me

# === SEO / public site URL ===
# Absolute origin used for sitemap.xml entries. Optional.
# If unset, the sitemap falls back to the incoming request's Host header,
# and route metadata (canonical / og:url) uses relative URLs that resolve
# against the current host. Set this for self-hosted deployments where you
# want a fixed canonical domain.
# Example: SITE_URL=https://rentflow.example.com
SITE_URL=

# === Demo gate (server-only) ===
# Credentials checked server-side before opening a demo session.
# Defaults to admin/admin when unset. Override per kind if needed.
DEMO_GATE_LOGIN=admin
DEMO_GATE_PASSWORD=admin
# Optional per-kind overrides:
# DEMO_GATE_DEMO_LOGIN=
# DEMO_GATE_DEMO_PASSWORD=
# DEMO_GATE_DEMO2_LOGIN=
# DEMO_GATE_DEMO2_PASSWORD=
# DEMO_GATE_MODERATOR_LOGIN=
# DEMO_GATE_MODERATOR_PASSWORD=
# DEMO_GATE_DEVELOPER_LOGIN=
# DEMO_GATE_DEVELOPER_PASSWORD=