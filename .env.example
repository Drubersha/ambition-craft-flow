# === App (Vite — build-time, inlined into client bundle) ===
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-generated-ANON_KEY
VITE_SUPABASE_PROJECT_ID=self-hosted

# === App (server runtime) ===
SUPABASE_URL=http://kong:8000
SUPABASE_PUBLISHABLE_KEY=replace-with-generated-ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=replace-with-generated-SERVICE_ROLE_KEY

# === Postgres ===
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=postgres

# === Supabase Auth (GoTrue) ===
# openssl rand -base64 48
JWT_SECRET=replace-with-strong-32+chars-secret
# Public site URL used in auth redirects and emails
SITE_URL=http://localhost:3000
# Disable email confirmation for dev; set true in production.
# To actually send registration / password-reset emails set this to `false`
# AND configure the SMTP block below (otherwise signups auto-confirm silently).
GOTRUE_MAILER_AUTOCONFIRM=true
# Allowed redirect URLs for auth links (comma-separated, * glob supported).
# Defaults to SITE_URL and SITE_URL/* — set only if extra origins are needed.
# Never use a bare "*": it lets crafted links redirect tokens to attacker pages.
# GOTRUE_URI_ALLOW_LIST=

# --- GoTrue SMTP (registration confirmation + password reset emails) ---
# These are sent by GoTrue itself (NOT the UniSender HTTP API below). Point them
# at UniSender Go's SMTP relay (or any SMTP). Leave blank to disable auth emails.
# UniSender Go SMTP: host smtp.unisender.ru, port 587, user = your sending email,
# pass = SMTP password from UniSender Go (Настройки → Конфигурация SMTP).
GOTRUE_SMTP_HOST=
GOTRUE_SMTP_PORT=587
GOTRUE_SMTP_USER=
GOTRUE_SMTP_PASS=
GOTRUE_SMTP_SENDER_NAME=LeasePlease
# From-address for auth emails (must be a verified sender in your SMTP provider)
GOTRUE_SMTP_ADMIN_EMAIL=no-reply@leaseplease.ru

# === Generated JWTs (use https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys or scripts/gen-keys.mjs) ===
ANON_KEY=replace-with-generated-ANON_KEY
SERVICE_ROLE_KEY=replace-with-generated-SERVICE_ROLE_KEY

# === Studio (optional admin UI) ===
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me

# === SEO / public site URL ===
# Absolute origin used for sitemap.xml entries. Optional.
# If unset, the sitemap falls back to the incoming request's Host header,
# and route metadata (canonical / og:url) uses relative URLs that resolve
# against the current host. Set this for self-hosted deployments where you
# want a fixed canonical domain.
# Example: SITE_URL=https://leaseplease.example.com
SITE_URL=

# === Transactional email (server-only) — UniSender Go ===
# Used by the FAQ feedback form (questions are emailed to the developer) and
# other app notifications. Delivery is OFF until these are set (submissions are
# just logged server-side). Uses the UniSender Go transactional API.
# UNISENDER_GO_API_KEY=your_unisender_go_api_key
# EMAIL_FROM=LeasePlease <no-reply@leaseplease.ru>   # адрес/домен должен быть подтверждён в UniSender Go
# UNISENDER_GO_API_URL=https://goapi.unisender.ru/ru/transactional/api/v1/email/send.json  # опц.: свой дата-центр (go1/go2)

# --- In-app notification emails (server-only) ---
# Every in-app notification (задачи, чаты, договоры, начисления, …) is emailed to
# the recipient. The DB (pg_net) calls the app webhook /api/notify-email with this
# shared secret; the app then sends via the UniSender Go API above.
# Generate: openssl rand -hex 32
NOTIFY_WEBHOOK_SECRET=
# After setting this, register the webhook in the DB (once), e.g.:
#   INSERT INTO public.email_settings (id, webhook_url, webhook_secret, enabled)
#   VALUES (true, 'http://app:3000/api/notify-email', '<NOTIFY_WEBHOOK_SECRET>', true)
#   ON CONFLICT (id) DO UPDATE SET webhook_url = EXCLUDED.webhook_url,
#     webhook_secret = EXCLUDED.webhook_secret, enabled = EXCLUDED.enabled;

# === Demo gate (server-only) ===
# Credentials checked server-side before opening a demo session.
# Defaults to admin/admin when unset. Override per kind if needed.
DEMO_GATE_LOGIN=admin
DEMO_GATE_PASSWORD=admin
# Optional per-kind overrides:
# DEMO_GATE_DEMO_LOGIN=
# DEMO_GATE_DEMO_PASSWORD=
# DEMO_GATE_DEMO2_LOGIN=
# DEMO_GATE_DEMO2_PASSWORD=
# DEMO_GATE_MODERATOR_LOGIN=
# DEMO_GATE_MODERATOR_PASSWORD=
# DEMO_GATE_DEVELOPER_LOGIN=
# DEMO_GATE_DEVELOPER_PASSWORD=

# === Realtime (WebSockets) ===
# openssl rand -base64 48
SECRET_KEY_BASE=replace-with-strong-64-char-secret

# === AI: распознавание задач из чата ===
# OpenAI-совместимый провайдер. Если заданы AI_BASE_URL и AI_API_KEY — используется он,
# иначе fallback на LOVABLE_API_KEY (доступен только в Lovable Cloud).
# Пример локального текстового ИИ (ollama):
#   AI_BASE_URL=http://ollama:11434/v1
#   AI_API_KEY=ollama
#   AI_MODEL=qwen2.5:1.5b
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
LOVABLE_API_KEY=

# --- Лимиты нагрузки на self-hosted ИИ (учитывают, что модель делит CPU/RAM с
# Postgres, Supabase и приложением; анализ запускается на КАЖДОЕ сообщение
# арендатора, поэтому всплеск может перегрузить сервер). Все значения опциональны. ---
# Сколько генераций выполняется одновременно в процессе (для одной локальной
# CPU-модели держите 1-2, чтобы всплеск не «съел» ядра и не тормозил Postgres):
AI_MAX_CONCURRENCY=2
# Сколько запросов сверх лимита ждут очереди (дальше — быстрый отказ, reason=busy):
AI_MAX_QUEUE=32
# Бюджет на один запрос, мс (зависшая/долгая генерация прерывается и освобождает слот):
AI_TIMEOUT_MS=60000
# Потолок сгенерированных токенов (ограничивает худшее время генерации на CPU):
AI_MAX_OUTPUT_TOKENS=400
# Ретраи SDK на временные (сетевые/5xx) ошибки — низкие, чтобы не множить нагрузку:
AI_MAX_RETRIES=1
# Поле reasoning повышает точность на пограничных сообщениях, но ~вдвое увеличивает
# число токенов (латентность). На очень слабом сервере поставьте false:
AI_REASONING=true